{
  "openapi": "3.0.3",
  "info": {
    "title": "IoT Smart Lock & Access Management API",
    "description": "Comprehensive REST and Real-Time API specification for managing smart locks, role-based user permissions, temporary guest PIN codes with BullMQ auto-expiration, and asynchronous command-ack MQTT validation flows.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["ADMIN", "MANAGER", "USER"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Lock": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["LOCKED", "UNLOCKED"] },
          "isOnline": { "type": "boolean" },
          "lastHeartbeat": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AccessLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "lockId": { "type": "string" },
          "userId": { "type": "string", "format": "uuid", "nullable": true },
          "pinUsed": { "type": "string", "nullable": true },
          "method": { "type": "string", "enum": ["API", "PIN"] },
          "result": { "type": "string", "enum": ["SUCCESS", "FAILED_UNAUTHORIZED", "FAILED_EXPIRED_PIN", "FAILED_OFFLINE", "FAILED_DEVICE_ERROR"] },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 },
                  "role": { "type": "string", "enum": ["ADMIN", "MANAGER", "USER"], "default": "USER" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "description": "User already exists or missing fields" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user & issue JWT",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user details",
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/locks": {
      "post": {
        "summary": "Register a lock (Admin only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "description": "Unique lock device identifier" },
                  "name": { "type": "string", "description": "Friendly name" }
                },
                "required": ["id", "name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lock registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Lock" }
              }
            }
          },
          "403": { "description": "Forbidden - Admins only" }
        }
      },
      "get": {
        "summary": "List all registered locks (Admin & Manager)",
        "responses": {
          "200": {
            "description": "Array of locks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Lock" }
                }
              }
            }
          }
        }
      }
    },
    "/api/locks/{id}": {
      "get": {
        "summary": "Retrieve lock details by ID (Admin & Manager)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lock" } } }
          },
          "404": { "description": "Lock not found" }
        }
      },
      "put": {
        "summary": "Update lock details (Admin only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string", "enum": ["LOCKED", "UNLOCKED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lock" } } }
          }
        }
      },
      "delete": {
        "summary": "Unregister a lock (Admin only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Lock deleted successfully" }
        }
      }
    },
    "/api/locks/{id}/unlock": {
      "post": {
        "summary": "Unlock a lock remotely (Checks user permissions & bridges MQTT command-ack flow)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Unlock command acknowledged by device",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "lock": { "$ref": "#/components/schemas/Lock" }
                  }
                }
              }
            }
          },
          "504": { "description": "Device offline or communication timeout" }
        }
      }
    },
    "/api/locks/{id}/temp-pin": {
      "post": {
        "summary": "Create a temporary keypad PIN code (Admin & Manager)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string", "format": "uuid" },
                  "pin": { "type": "string", "pattern": "^\\d+$" },
                  "durationSeconds": { "type": "integer", "minimum": 1 }
                },
                "required": ["userId", "pin", "durationSeconds"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "PIN scheduled in BullMQ background job queue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "tempPin": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "lockId": { "type": "string" },
                        "userId": { "type": "string" },
                        "pin": { "type": "string" },
                        "expiresAt": { "type": "string" },
                        "isActive": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/locks/{id}/logs": {
      "get": {
        "summary": "Retrieve access audit logs for a lock (Admin & Manager)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "logs": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AccessLog" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/permissions/grant": {
      "post": {
        "summary": "Grant user lock access permission (Admin & Manager)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string", "format": "uuid" },
                  "lockId": { "type": "string" }
                },
                "required": ["userId", "lockId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Permission granted successfully" }
        }
      }
    },
    "/api/permissions/revoke": {
      "post": {
        "summary": "Revoke user lock access permission (Admin & Manager)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string", "format": "uuid" },
                  "lockId": { "type": "string" }
                },
                "required": ["userId", "lockId"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Permission revoked successfully" }
        }
      }
    },
    "/api/permissions/my-locks": {
      "get": {
        "summary": "List all locks the authenticated user is allowed to access",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Lock" }
                }
              }
            }
          }
        }
      }
    }
  }
}
